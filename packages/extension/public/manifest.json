{
  "manifest_version": 3,
  "name": "RTC Inspector",
  "version": "0.1.0",
  "description": "See what any page's WebRTC connections are doing: signaling, ICE, data channels and stats. Everything stays in your browser.",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "action": {
    "default_title": "RTC Inspector: no WebRTC on this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png",
      "48": "icons/inactive-48.png",
      "128": "icons/inactive-128.png"
    }
  },
  "background": {
    "service_worker": "background.global.js"
  },
  "devtools_page": "devtools.html",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.global.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "relay.global.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
