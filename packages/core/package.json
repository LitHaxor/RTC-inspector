{
  "name": "@rtc-inspector/core",
  "version": "0.1.0",
  "description": "Framework-independent WebRTC instrumentation, parsers and diagnostics for RTC Inspector",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target es2020 && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
